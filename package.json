    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "claude-code"
  ],
  "homepage": "https://github.com/ThiagoNascBarros/brainwright#readme",
  "bugs": {
    "url": "https://github.com/ThiagoNascBarros/brainwright/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThiagoNascBarros/brainwright.git"
  },
  "license": "MIT",
